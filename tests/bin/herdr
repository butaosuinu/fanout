#!/usr/bin/env bash
# Tier 2 shim for Herdr 0.7.5 CLI calls.
#
# Each Tier 2 test sets FIXTURE_DIR=tests/fixtures/<name>. Every verb below
# answers from a per-scenario fixture file in that directory:
#
#   herdr --version                   -> $FIXTURE_DIR/herdr-version.txt, or
#                                        `herdr 0.7.5` when absent
#   herdr [--session S] status --json -> $FIXTURE_DIR/herdr-status.json
#   herdr api snapshot                -> $FIXTURE_DIR/herdr-snapshot.json
#   herdr <verb> <sub> ...            -> $FIXTURE_DIR/herdr-<verb>-<sub>.json
#
# The two named files keep the pre-existing scenario contract; every other
# verb derives its file from the first two argv words (`workspace create` ->
# herdr-workspace-create.json). A scenario that does not ship the file for a
# verb it reaches fails loudly rather than inventing a response, because the
# Go side validates each envelope's `id` and `result.type` and a silent empty
# body would look like a protocol regression instead of a missing fixture.
#
# Failure injection: writing $FIXTURE_DIR/herdr-<key>.exit (an integer) makes
# that verb exit with that code, emitting $FIXTURE_DIR/herdr-<key>.err on
# stderr and the .json body on stdout when either exists. This reproduces the
# rejection envelopes Herdr returns on a non-zero exit.
#
# Argv log: with HERDR_SHIM_LOG set, every invocation appends one
# space-joined argv line to that path so a test can assert which commands
# fanout issued, and in what order. Arguments containing spaces are logged
# verbatim, so assertions should match on the verb prefix rather than
# re-splitting the line.
#
# Tier 1 "force_missing herdr" still wins because helpers.bash rebuilds PATH
# to a sanitized directory that excludes this shim.

set -euo pipefail

fixture="${FIXTURE_DIR:-}"

if [[ -n "${HERDR_SHIM_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "$HERDR_SHIM_LOG"
fi

# Emit one fixture file, or fail loudly when the scenario did not ship it.
emit_fixture() {
  local path="$1"
  if [[ -z "$fixture" || ! -f "$path" ]]; then
    echo "herdr shim: missing fixture $path" >&2
    exit 1
  fi
  cat "$path"
}

# Answer one verb from herdr-<key>.json, honoring the .exit / .err overrides.
respond() {
  local key="$1"
  local body="$fixture/herdr-$key.json"
  local status_file="$fixture/herdr-$key.exit"
  local stderr_file="$fixture/herdr-$key.err"

  if [[ -n "$fixture" && -f "$status_file" ]]; then
    if [[ -f "$stderr_file" ]]; then
      cat "$stderr_file" >&2
    fi
    if [[ -f "$body" ]]; then
      cat "$body"
    fi
    exit "$(cat "$status_file")"
  fi
  emit_fixture "$body"
}

if [[ "${1:-}" == "--version" ]]; then
  if [[ -n "$fixture" && -f "$fixture/herdr-version.txt" ]]; then
    cat "$fixture/herdr-version.txt"
  else
    printf 'herdr 0.7.5\n'
  fi
  exit 0
fi

if [[ "${1:-}" == "--session" ]]; then
  shift 2
fi

case "${1:-} ${2:-}" in
  "status --json")
    emit_fixture "$fixture/herdr-status.json"
    ;;
  "api snapshot")
    emit_fixture "$fixture/herdr-snapshot.json"
    ;;
  # Mutation and observation verbs fanout issues once it holds an owned
  # session. Keep this list in sync with internal/infra/herdrrun; an
  # unlisted verb must stay an error so a new call site surfaces here.
  # `herdr server` is deliberately absent: it daemonizes and serves the
  # socket, so a black-box run reaching it is a bug, not a missing fixture.
  "workspace create" | "workspace close" | "workspace focus" | "workspace report-metadata" | \
  "worktree create" | "worktree open" | "worktree remove" | \
  "agent prompt" | "agent rename" | "agent focus" | \
  "pane read" | "pane run" | "pane close" | "pane wait-output" | "pane process-info" | \
  "pane report-metadata" | "plugin list")
    respond "${1}-${2}"
    ;;
  *)
    echo "herdr shim: unsupported command: $*" >&2
    exit 1
    ;;
esac
