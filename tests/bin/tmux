#!/usr/bin/env bash
# Tier 2 shim: fixture-driven `tmux` dispatch for fanout's direct runtime.
#
# Each Tier 2 test sets FIXTURE_DIR=tests/fixtures/<name>. The shim
# reads per-call fixtures from that directory:
#
#   tmux display-message -p '#{session_name}'
#       - echoes the first line of $FIXTURE_DIR/tmux-sessions.txt.
#
#   tmux display-message -p '#{pane_id}'
#       - echoes %1, matching helpers.bash's TMUX_PANE default.
#
#   tmux split-window -P -F '#{pane_id}' ...
#       - echoes %99 for tests that reach the live launch path.
#
#   tmux send-keys / select-layout / select-pane
#       - no-op. Dry-run tests do not execute these, but the shims keep
#         targeted launch tests hermetic.
#
# Tier 1 "force_missing tmux" still wins because helpers.bash rebuilds
# PATH to a sanitized directory that excludes this shim.

set -euo pipefail

fixture="${FIXTURE_DIR:-}"

case "${1:-}" in
  display-message)
    if [[ "${2:-}" == "-p" ]]; then
      if [[ "${3:-}" == "#{pane_id}" ]]; then
        printf '%%1\n'
      elif [[ -n "$fixture" && -f "$fixture/tmux-sessions.txt" ]]; then
        head -n 1 "$fixture/tmux-sessions.txt"
      else
        printf 'fanout\n'
      fi
      exit 0
    fi
    ;;
  list-sessions)
    if [[ -n "$fixture" && -f "$fixture/tmux-sessions.txt" ]]; then
      cat "$fixture/tmux-sessions.txt"
    fi
    exit 0
    ;;
  send-keys)
    exit 0
    ;;
  split-window)
    printf '%%99\n'
    exit 0
    ;;
  select-layout|select-pane)
    exit 0
    ;;
esac

exit 0
