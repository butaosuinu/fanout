#!/usr/bin/env bash
# Tier 2 shim: fixture-driven `gh` dispatch.
#
# Each Tier 2 test sets FIXTURE_DIR=tests/fixtures/<name> before invoking
# fanout. The shim reads per-call fixtures from that directory:
#
#   gh extension list
#       — always returns a line advertising the gh-sub-issue extension.
#         (fanout:396 only checks presence, never the version.)
#
#   gh sub-issue list <parent> --json number,title,state
#       — echoes $FIXTURE_DIR/gh-sub-issue-list.json verbatim
#         (shape: {"subIssues":[...]}).
#
#   gh issue view <N> --json ... [-q <filter>]
#       — echoes $FIXTURE_DIR/gh-issue-view-<N>.json verbatim, or if a -q
#         filter was passed, pipes the fixture through real jq first.
#         fanout uses -q .state and -q .body against the same endpoint,
#         so fixtures are full issue objects (number/title/state/body/labels).
#
#   gh api --paginate --slurp repos/{owner}/{repo}/issues/<N>/comments?per_page=100
#       — echoes $FIXTURE_DIR/gh-issue-comments-<N>.json verbatim.
#         The dashboard edit path uses this to find an existing marker comment
#         across every comments page before creating a new comment.
#
#   gh issue comment <N> --body-file -
#       — consumes stdin and exits 0. The dashboard posting path uses this
#         for first-time parent dashboard comments. --edit-last is rejected
#         so tests pin marker-based idempotency instead of last-comment edits.
#
#   gh repo view --json <fields> [-q <filter>]
#       — echoes $FIXTURE_DIR/gh-repo-view.json (with optional jq filter).
#         Project mode calls this to resolve the cross-repo filter target
#         (typical fixture: {"nameWithOwner":"butaosuinu/fanout"}).
#
#   gh pr view <N> --json number,additions,deletions,changedFiles,title,body
#       — echoes $FIXTURE_DIR/gh-pr-view-<N>.json verbatim.
#         --status --format table and --status --post-dashboard use this to
#         render PR diff rows and extract dashboard TL;DR / review score.
#
#   gh release view -R butaosuinu/fanout --json tagName -q .tagName
#       — echoes $FIXTURE_DIR/gh-release-view.json (with optional jq filter).
#         --check-update calls this to resolve the latest release tag without
#         touching the network.
#
#   gh release list -R butaosuinu/fanout --json tagName -q '.[0].tagName'
#       — echoes $FIXTURE_DIR/gh-release-list.json (with optional jq filter).
#         Not used by fanout today, but kept next to release view so tests
#         can cover either gh release lookup style.
#
#   gh api graphql -f query=... -F owner=X -F number=Y -F first=Z [-F after=C]
#       — Project mode pagination. Without `-F after=...`, echoes
#         $FIXTURE_DIR/gh-graphql-page-1.json. With `-F after=<cursor>`,
#         echoes $FIXTURE_DIR/gh-graphql-after-<cursor>.json. All current
#         fixtures use a single page (hasNextPage:false) so only page-1.json
#         is needed.
#
#   gh api graphql -F num=<N> [-F after=<cursor>]
#       — --status per-issue PR lookup. Without `-F after=`, echoes
#         $FIXTURE_DIR/gh-issue-view-<N>.json (same per-issue fixture as the
#         legacy `gh issue view <N>` path; the real script uses
#         --jq .data.repository.issue server-side so the on-the-wire shape
#         matches the fixture). With `-F after=<cursor>`, echoes
#         $FIXTURE_DIR/gh-issue-view-<N>-after-<cursor>.json for
#         closedByPullRequestsReferences pagination tests. The `num=`
#         dispatch takes precedence over the project-mode cursor branch
#         when only `num=` is present without `after=`.
#
#   gh api -X PATCH /repos/<owner>/<repo>/issues/comments/<id> -F body=@-
#       — consumes stdin and exits 0. The dashboard edit path uses this when
#         the parent issue already has a marker comment.
#
# Tier 1 "force_missing gh" still wins because helpers.bash rebuilds PATH
# to a sanitized directory that excludes this shim.

set -euo pipefail

fixture="${FIXTURE_DIR:-}"

# Emit a fixture file, optionally filtered through real jq. The $label is
# used only in the "FIXTURE_DIR not set" error so the test reader can tell
# which gh subcommand the missing fixture belonged to.
emit_fixture() {
  local fx="$1" jq_filter="${2:-}" label="${3:-}"
  if [[ -z "$fixture" ]]; then
    echo "gh shim: FIXTURE_DIR not set ($label)" >&2
    exit 1
  fi
  if [[ ! -f "$fx" ]]; then
    echo "gh shim: missing $fx" >&2
    exit 1
  fi
  if [[ -n "$jq_filter" ]]; then
    jq -r "$jq_filter" "$fx"
  else
    cat "$fx"
  fi
}

# Extract the -q/--jq filter (if any) from a `gh ... --json X -q F` style
# argv tail. Echoes the filter or empty. --json's value is consumed and
# ignored — we always emit full fixture JSON and let the caller's filter
# (or its absence) shape the output.
extract_jq_filter() {
  local filter=""
  while (( $# )); do
    case "$1" in
      --json) shift 2;;
      -q|--jq) filter="$2"; shift 2;;
      *) shift;;
    esac
  done
  printf '%s' "$filter"
}

case "${1:-}" in
  extension)
    if [[ "${2:-}" == "list" ]]; then
      printf 'gh sub-issue\tyahsan2/gh-sub-issue\tv0.5.0\n'
      exit 0
    fi
    ;;
  sub-issue)
    if [[ "${2:-}" == "list" ]]; then
      emit_fixture "$fixture/gh-sub-issue-list.json" "" "gh sub-issue list $*"
      exit 0
    fi
    ;;
  issue)
    if [[ "${2:-}" == "view" ]]; then
      num="${3:-}"
      shift 3 2>/dev/null || true
      jq_filter="$(extract_jq_filter "$@")"
      emit_fixture "$fixture/gh-issue-view-$num.json" "$jq_filter" "gh issue view $num"
      exit 0
    fi
    if [[ "${2:-}" == "comment" ]]; then
      num="${3:-}"
      shift 3
      body_file=""
      while (( $# )); do
        case "$1" in
          --edit-last)
            echo "gh shim: --edit-last must not be used for dashboard comments" >&2
            exit 1;;
          --body-file)
            body_file="${2:-}"
            shift 2;;
          *)
            shift;;
        esac
      done
      if [[ "$body_file" != "-" ]]; then
        echo "gh shim: issue comment $num requires --body-file -" >&2
        exit 1
      fi
      cat >/dev/null
      exit 0
    fi
    ;;
  repo)
    if [[ "${2:-}" == "view" ]]; then
      shift 2
      jq_filter="$(extract_jq_filter "$@")"
      emit_fixture "$fixture/gh-repo-view.json" "$jq_filter" "gh repo view"
      exit 0
    fi
    ;;
  pr)
    if [[ "${2:-}" == "view" ]]; then
      num="${3:-}"
      shift 3
      jq_filter="$(extract_jq_filter "$@")"
      emit_fixture "$fixture/gh-pr-view-$num.json" "$jq_filter" "gh pr view $num"
      exit 0
    fi
    ;;
  release)
    if [[ "${2:-}" == "view" ]]; then
      shift 2
      jq_filter="$(extract_jq_filter "$@")"
      emit_fixture "$fixture/gh-release-view.json" "$jq_filter" "gh release view"
      exit 0
    fi
    if [[ "${2:-}" == "list" ]]; then
      shift 2
      jq_filter="$(extract_jq_filter "$@")"
      emit_fixture "$fixture/gh-release-list.json" "$jq_filter" "gh release list"
      exit 0
    fi
    ;;
  api)
    if [[ "${2:-}" == "--paginate" && "${3:-}" == "--slurp" ]]; then
      path="${4:-}"
      if [[ "$path" == repos/\{owner\}/\{repo\}/issues/*/comments\?per_page=100 ]]; then
        num="${path#repos/\{owner\}/\{repo\}/issues/}"
        num="${num%%/comments?per_page=100}"
        emit_fixture "$fixture/gh-issue-comments-$num.json" "" "gh api paginated issue comments $num"
        exit 0
      fi
    fi
    if [[ "${2:-}" == "-X" && "${3:-}" == "PATCH" ]]; then
      path="${4:-}"
      shift 4
      body_field=""
      while (( $# )); do
        case "$1" in
          -f|-F)
            kv="${2:-}"
            [[ "$kv" == body=* ]] && body_field="${kv#body=}"
            shift 2;;
          *) shift;;
        esac
      done
      if [[ "$path" != /repos/*/issues/comments/* ]]; then
        echo "gh shim: unexpected PATCH path: $path" >&2
        exit 1
      fi
      if [[ "$body_field" != "@-" ]]; then
        echo "gh shim: PATCH dashboard comment requires -F body=@-" >&2
        exit 1
      fi
      cat >/dev/null
      exit 0
    fi
    if [[ "${2:-}" == "graphql" ]]; then
      shift 2
      # Two dispatch paths share this branch:
      #  (a) Project mode: -F after=<cursor> picks the page fixture.
      #  (b) --status per-issue PR lookup: -F num=<N> picks
      #      gh-issue-view-<N>.json, or gh-issue-view-<N>-after-<cursor>.json
      #      when paginating closedByPullRequestsReferences. Fixtures are
      #      already in the inner {state, closedByPullRequestsReferences:{...}}
      #      shape because the real script uses --jq .data.repository.issue
      #      to extract that subtree.
      # All other -f/-F flags are consumed and ignored.
      cursor=""
      issue_num=""
      while (( $# )); do
        case "$1" in
          -f|-F)
            kv="${2:-}"
            [[ "$kv" == after=* ]] && cursor="${kv#after=}"
            [[ "$kv" == num=*   ]] && issue_num="${kv#num=}"
            shift 2;;
          *) shift;;
        esac
      done
      if [[ -n "$issue_num" ]]; then
        if [[ -n "$cursor" ]]; then
          emit_fixture "$fixture/gh-issue-view-$issue_num-after-$cursor.json" "" "gh api graphql num=$issue_num after=$cursor"
        else
          emit_fixture "$fixture/gh-issue-view-$issue_num.json" "" "gh api graphql num=$issue_num"
        fi
        exit 0
      fi
      if [[ -n "$cursor" ]]; then
        fx="$fixture/gh-graphql-after-$cursor.json"
      else
        fx="$fixture/gh-graphql-page-1.json"
      fi
      emit_fixture "$fx" "" "gh api graphql"
      exit 0
    fi
    ;;
esac

echo "gh shim: unhandled argv: $*" >&2
exit 1
