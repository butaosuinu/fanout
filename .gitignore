.claude/settings.local.json
# .codex/ holds machine-local Codex state except the tracked repo hooks
.codex/*
!.codex/hooks.json
.dmux/
.fanout/
!.fanout/
.fanout/*
!.fanout/config.json
.cache/
tests/tmp/
/fanout-go
/fanout
# Local dmux/cmux session artifacts (machine-local hook output; never committed)
.claude/dmux/
.claude/hooks/dmux-stop-hook.cjs
# Hugo build output (site/ is built in CI by pages.yml)
site/public/
site/.hugo_build.lock
site/resources/
# Dashboard web UI: built bundle (make build-web) is embedded, never committed
internal/ui/dashboard/static/*
!internal/ui/dashboard/static/.gitkeep
web/node_modules/
.pnpm-store/
# Translation catalogs: the .po files are the source of truth and are tracked.
# `lingui compile` output next to them is a verification artifact only — the
# runtime compiles .po through @lingui/vite-plugin at build time.
web/src/locales/*.js
