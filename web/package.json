{
  "name": "fanout-dashboard-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt src vite.config.ts lingui.config.ts",
    "fmt:check": "oxfmt --check src vite.config.ts lingui.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:extract": "lingui extract --clean",
    "i18n:verify": "lingui compile --strict"
  },
  "dependencies": {
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@pierre/diffs": "~1.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "oxfmt": "0.61.0",
    "oxlint": "^1.69.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
