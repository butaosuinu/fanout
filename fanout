#!/usr/bin/env bash
# fanout — fan a GitHub parent issue's OPEN children out into dmux panes.
#
# Background: dmux v5.6.3 (the current npm latest) does NOT ship the HTTP API
# that its context/API.md describes. We drive pane creation through the dmux
# TUI via `tmux send-keys` against the control pane for the session.
#
# See ./README.md for the full design notes.

set -euo pipefail

readonly FANOUT_TAG_PREFIX='[fanout #'

default_sleep_between=4
default_wait_timeout=60
default_popup_timeout=20

usage() {
  cat <<'EOF'
Usage: fanout <parent-issue|project-url> [options]

Creates one dmux pane per OPEN sub-issue of the given parent issue, OR per
OPEN item in the given Projects v2 URL (e.g. https://github.com/users/<u>/projects/<n>
or https://github.com/orgs/<o>/projects/<n>). Each pane gets a dedicated git
worktree (dmux handles that) and starts the configured agent with a briefing
that points at /tmp/fanout-<repo>-<num>.md.

Options:
  --agent <name>      Agent to launch (claude|codex|opencode|...). Required
                      unless the caller's tmux pane is itself a dmux-managed
                      pane — in that case fanout auto-detects the agent from
                      dmux.config.json. dmux v5.6.3 always opens an agent-
                      choice popup after the prompt popup, so fanout must
                      know the agent name to inject into it.
  --limit <N>         Cap how many children to enqueue this run. Remainder is
                      printed with a rerun command.
  --only <list>       Comma-separated list of issue numbers to fan out,
                      e.g. --only 4,7,8,10. Numbers not present in the OPEN
                      child set (Sub-issues API + parent body task-list
                      union) are warned and ignored; fanout never widens the
                      search to arbitrary issues. Cannot be combined with
                      --skip. Applied before --limit.
  --skip <list>       Comma-separated list of issue numbers to exclude,
                      e.g. --skip 6,9. Everything else in the OPEN child
                      set is fanned out. Cannot be combined with --only.
                      Applied before --limit.
  --include <list>    Comma-separated list of issue numbers to force-add to
                      the children set even if they aren't returned by the
                      Sub-issues API or picked up from the parent body's
                      task-list scan, e.g. --include 123,456. Intended for
                      the bundled Claude/Codex agent integrations, which
                      read the parent body for implicit child references
                      (close keywords, prose, Japanese idioms) and forward
                      the accepted numbers here. Combines with --only/--skip
                      (included first, then filtered). Numbers that end up
                      CLOSED or don't exist are warned and skipped.
  --name <NUM>=<slug-hint>[|<display-name>]
                      Override the default naming for issue <NUM>. Repeatable
                      (once per issue). <slug-hint> is 2-4 kebab-case words
                      (lowercase alnum + hyphens) front-loaded into the one-
                      line prompt so dmux's slug generator is very likely to
                      echo it as the branch / worktree directory name — this
                      is the only reliable way to name branches/worktrees
                      because dmux computes them from the prompt at creation
                      time and they become immutable git state afterward.
                      <display-name> (optional; ≤80 chars after sanitization)
                      is written post-creation into panes[].displayName in
                      dmux.config.json and merged into the worktree's
                      .dmux/worktree-metadata.json, so dmux's enforcePaneTitles
                      loop (every 5-30s) surfaces it as the tmux pane border
                      title and reopenWorktree restores it across restarts.
                      Intended to be filled in by the bundled Claude/Codex
                      agent integrations, which generate both hints from
                      issue title/body using in-conversation reasoning (no
                      extra LLM call).
                      Examples:
                        --name 17=fix-login-timeout|Fix login
                        --name 18=update-docs
                        --name 19=|Bug triage   (display-name only)
  --unblocked-only    Only fan out children whose blockers are all CLOSED.
                      Blockers are read from (1) the child body's
                      "## Blocked by" section, (2) a "(blocked by #X, #Y)"
                      trailer on the parent's task-list row, and (3) the
                      child's "blocked" label (weak signal — logged but
                      not deduced from). Children with any OPEN blocker
                      are reported as deferred in the final summary.
                      Safe to rerun as blocker PRs merge.
  --session <name>    Target a specific tmux session (required when more than
                      one dmux session is alive on this machine).
  --project-status <name>
                      [project mode only] Restrict to Project items whose
                      single-select "Status" field equals <name>. Default:
                      "Todo". Pass `--project-status all` to disable the
                      filter. If the Project has no Status field, fanout
                      warns and falls back to all items. Ignored in issue
                      mode.
  --sleep <seconds>   Pause between pane-creation requests. Default 4. Raise
                      this if dmux reports "pane creation failed" under load.
  --popup-timeout <s> Seconds to wait for each dmux popup (new-pane, agent-
                      choice) to appear after the triggering keystroke.
                      Default 20. Raise on slow machines or large worktrees
                      where dmux takes longer than that between closing the
                      prompt popup and opening the agent-choice popup.
  --dry-run           Print the send-keys commands, the popup JSON payloads
                      that would be injected, and the briefings, without
                      driving dmux.
  --debug             Log intercept steps (popup PID, result file path, JSON
                      payload) to stderr as each pane is created.
  --status            Read-only mode. Print JSON describing each fanned-out
                      child issue's state and the merge status of its
                      closed-by PRs, then exit. Reads dmux.config.json to
                      enumerate already-fanned children (panes whose prompt
                      starts with "[fanout #N of #<parent>]") and calls
                      `gh issue view` for each. Children of other parents in
                      the same session are filtered out. Old-format panes
                      ("[fanout #N]" without parent annotation, predating
                      this feature) are excluded; the next non-status
                      `fanout <parent>` run rewrites their prompts in place
                      to include the parent annotation, so a subsequent
                      --status picks them up automatically. No side
                      effects. Set DMUX_CONFIG_PATH to bypass
                      live-dmux-session discovery (useful after the session
                      has exited). Exclusive with all action-bearing flags.
                      JSON shape and dedicated exit codes documented below.
  -h, --help          Show this message.

Prerequisites:
  * gh, jq, tmux, pgrep installed. gh-sub-issue extension is required for
    issue mode only (project mode uses `gh api graphql`); for project mode
    the gh token must additionally carry the `read:project` scope.
    For `--status` (read-only JSON status reporter) the live-dmux-session
    deps shrink to {gh, jq, tmux}; setting DMUX_CONFIG_PATH lets it run
    with just {gh, jq} (no tmux).
  * `cd <repo> && dmux` has been run; tmux session is alive.
  * dmux TUI is on the pane-list view (no modal open). fanout sends one Esc
    at startup as a best-effort.
  * --agent given, OR the caller's pane is a dmux-managed pane so fanout
    can auto-detect it. dmux v5.6.3 routes new-pane prompts through
    tmux display-popup (a separate tmux client that send-keys cannot
    reach), so fanout drives the flow by intercepting the popup's result
    file. The agent name is required to satisfy the picker popup that
    dmux always shows next.

Exit codes (default flow):
  0 success (including "no children, nothing to do")
  1 prerequisite / environment problem
  2 bad invocation

Exit codes (--status):
  0 success (JSON emitted; check `summary.all_merged` for state)
  2 cannot enumerate children (bad invocation, missing/unreadable
    dmux.config.json, no active dmux session)
  3 gh API call failed (auth, network, non-existent issue, etc.)

--status JSON schema (top-level):
  {
    "parent": <int>,
    "children": [
      { "num": <int>, "state": "OPEN"|"CLOSED",
        "prs": [ { "number": <int>, "state": "OPEN"|"MERGED"|"CLOSED",
                   "mergedAt": <ISO8601 | null> } ],
        "has_merged_pr": <bool> }
    ],
    "summary": {
      "total":      <int>,    # length of children
      "merged":     <int>,    # children with at least one MERGED PR
      "pending":    <int>,    # children with no MERGED PR
      "all_merged": <bool>    # total > 0 AND every child has_merged_pr
    }
  }
EOF
}

# --- color helpers -----------------------------------------------------------

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "${TERM:-dumb}" != dumb ]]; then
  C_INFO=$(tput setaf 4)
  C_OK=$(tput setaf 2)
  C_WARN=$(tput setaf 3)
  C_ERR=$(tput setaf 1)
  C_DIM=$(tput dim 2>/dev/null || true)
  C_RESET=$(tput sgr0)
else
  C_INFO=''; C_OK=''; C_WARN=''; C_ERR=''; C_DIM=''; C_RESET=''
fi

log_info()  { printf '%s[info]%s %s\n'  "$C_INFO"  "$C_RESET" "$*"; }
log_ok()    { printf '%s[ ok ]%s %s\n'  "$C_OK"    "$C_RESET" "$*"; }
log_warn()  { printf '%s[warn]%s %s\n'  "$C_WARN"  "$C_RESET" "$*" >&2; }
log_err()   { printf '%s[err ]%s %s\n'  "$C_ERR"   "$C_RESET" "$*" >&2; }
log_dim()   { printf '%s%s%s\n'         "$C_DIM"   "$*"        "$C_RESET"; }
log_debug() { (( ${debug:-0} )) || return 0; printf '%s[dbg ]%s %s\n' "$C_DIM" "$C_RESET" "$*" >&2; }

die() {
  log_err "$*"
  exit 1
}

parse_num_csv() {
  # $1 flag name (for error messages), $2 csv string.
  # Echoes a space-sentinel-wrapped set (" 4 7 8 ") suitable for the
  # `*" $n "*` membership idiom used elsewhere in this script. Empty
  # entries (e.g. from "4,,7") and non-digit tokens are fatal.
  local name="$1" csv="$2" set=' ' tok
  local -a toks
  local IFS=,
  read -ra toks <<<"$csv"
  for tok in "${toks[@]}"; do
    [[ "$tok" =~ ^[0-9]+$ ]] || die "$name: invalid entry '$tok' (must be a positive integer)"
    set+="$tok "
  done
  printf '%s' "$set"
}

# --name storage: parallel indexed arrays instead of `declare -A`, because
# macOS ships bash 3.2 and associative arrays are 4+. Linear lookup is fine
# — `name_nums` has one entry per target issue (typically a handful).
name_nums=()
name_slug_hints=()
name_display_names=()

name_find_index() {
  # Echoes the index of $1 in name_nums, or empty if absent.
  local needle="$1" i
  for (( i=0; i<${#name_nums[@]}; i++ )); do
    if [[ "${name_nums[i]}" == "$needle" ]]; then
      printf '%s' "$i"
      return 0
    fi
  done
  return 1
}

name_get_slug_hint() {
  local idx
  idx=$(name_find_index "$1") || return 0
  printf '%s' "${name_slug_hints[$idx]}"
}

name_get_display_name() {
  local idx
  idx=$(name_find_index "$1") || return 0
  printf '%s' "${name_display_names[$idx]}"
}

name_has_any_display_name() {
  # Returns 0 iff at least one entry has a non-empty display-name. The
  # explicit length short-circuit is required on bash 3.2.57 (what macOS
  # ships) where `set -u` plus `"${empty_array[@]}"` trips "unbound
  # variable" — a quirk fixed in 4.4+ but we still have to live with.
  (( ${#name_display_names[@]} == 0 )) && return 1
  local v
  for v in "${name_display_names[@]}"; do
    [[ -n "$v" ]] && return 0
  done
  return 1
}

parse_name_arg() {
  # $1 raw value of --name, shaped "<NUM>=<slug-hint>[|<display-name>]".
  # Upserts into (name_nums, name_slug_hints, name_display_names). Either
  # side of the `|` may be empty, but at least one must be non-empty.
  local raw="$1"
  [[ "$raw" == *"="* ]] || die "--name requires <NUM>=<slug-hint>[|<display-name>], got: '$raw'"
  local num="${raw%%=*}"
  local val="${raw#*=}"
  [[ "$num" =~ ^[0-9]+$ ]] || die "--name: <NUM> must be a positive integer, got: '$num'"
  local slug_h disp_n
  if [[ "$val" == *"|"* ]]; then
    slug_h="${val%%|*}"
    disp_n="${val#*|}"
  else
    slug_h="$val"
    disp_n=""
  fi
  if [[ -z "$slug_h" && -z "$disp_n" ]]; then
    die "--name #$num: both slug-hint and display-name are empty"
  fi
  if [[ -n "$slug_h" ]]; then
    # Kebab-case: must start with alnum, contain only lowercase alnum and
    # hyphens. Matches what dmux's slug() sanitizes to, so echoing it into
    # the prompt gives the LLM the cleanest possible target.
    [[ "$slug_h" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
      || die "--name #$num: slug-hint must be lowercase kebab-case (alnum+hyphens, starting with alnum), got: '$slug_h'"
  fi
  local idx
  if idx=$(name_find_index "$num"); then
    # Merge: allow two --name calls for the same issue to build up slug + disp.
    [[ -n "$slug_h" ]] && name_slug_hints[idx]="$slug_h"
    [[ -n "$disp_n" ]] && name_display_names[idx]="$disp_n"
  else
    name_nums+=("$num")
    name_slug_hints+=("$slug_h")
    name_display_names+=("$disp_n")
  fi
}

# --- blocker parsing (used by --unblocked-only) -----------------------------

# Space-sentinel-wrapped cache string. Format: " <num>:<STATE> <num>:<STATE> ".
# Avoids `declare -A`, which macOS's bash 3.2 rejects. Mutations via
# command substitution would be lost in the subshell, so this function
# returns its value in GET_ISSUE_STATE_RESULT instead of echoing.
issue_state_cache=' '
GET_ISSUE_STATE_RESULT=''

get_issue_state() {
  # $1 issue number. Sets GET_ISSUE_STATE_RESULT to "OPEN"/"CLOSED"/"UNKNOWN".
  # Cached so repeated blocker references don't re-hit the API.
  local num="$1"
  if [[ "$issue_state_cache" == *" $num:"* ]]; then
    local rest="${issue_state_cache#* "$num":}"
    GET_ISSUE_STATE_RESULT="${rest%% *}"
    return 0
  fi
  local s
  s=$(gh_in_root issue view "$num" --json state -q .state 2>/dev/null | tr '[:lower:]' '[:upper:]')
  [[ -z "$s" ]] && s='UNKNOWN'
  issue_state_cache+="$num:$s "
  GET_ISSUE_STATE_RESULT="$s"
}

get_issue_with_prs() {
  # $1 issue number. Echoes raw JSON
  #   {state, closedByPullRequestsReferences:[{number,url,repository}, …]}
  # exactly as gh returns it. No cache: the JSON-array shape doesn't fit
  # get_issue_state's string cache, and the single use site is one-shot.
  # Returns gh's exit status so callers can distinguish API failures from
  # empty results.
  local num="$1"
  gh_in_root issue view "$num" --json state,closedByPullRequestsReferences 2>/dev/null
}

get_pr_with_status() {
  # $1 PR selector (URL or number). Echoes raw JSON with merge status fields.
  local pr="$1"
  gh_in_root pr view "$pr" --json number,state,mergedAt 2>/dev/null
}

parse_blockers_from_child_body() {
  # $1 body text. Echoes space-separated blocker numbers taken from the first
  # "## Blocked by" section, up to the next blank line or next heading.
  # Uses tolower() for portability — BSD awk (macOS default) doesn't honor
  # gawk's IGNORECASE.
  awk '
    BEGIN { in_section=0 }
    { lower = tolower($0) }
    lower ~ /^##[[:space:]]+blocked by/ { in_section=1; next }
    in_section && /^[[:space:]]*$/ { in_section=0; next }
    in_section && /^##/ { in_section=0; next }
    in_section {
      s=$0
      while (match(s, /#[0-9]+/)) {
        printf "%s ", substr(s, RSTART+1, RLENGTH-1)
        s = substr(s, RSTART+RLENGTH)
      }
    }
  ' <<<"$1"
}

parse_blockers_from_parent_row() {
  # $1 parent body, $2 child number. Echoes space-separated blocker numbers
  # extracted from a "(blocked by #X, #Y)" trailer on the task-list row that
  # starts with "#<child>". Returns empty if no such trailer.
  local parent_body="$1" child="$2"
  printf '%s' "$parent_body" | jq -Rrs --arg c "$child" '
    split("\n")
    | map(select(test("^[[:space:]]*-[[:space:]]+\\[[ xX]\\][[:space:]]*#" + $c + "([^0-9]|$)")))
    | map(capture("\\(blocked by (?<refs>[^)]+)\\)"; "i") // null)
    | map(select(. != null))
    | map(.refs)
    | join(" ")
    | [scan("#([0-9]+)") | .[0]]
    | join(" ")
  '
}

migrate_legacy_pane_tags() {
  # Pre-#35 fanouts wrote `[fanout #N]` prompts without a parent annotation,
  # which `--status <parent>` filters out (it can't tell which parent owns
  # them). The doc tells users to re-fan to surface them, but idempotency
  # would otherwise treat the legacy pane as already-fanned and skip it,
  # leaving the legacy prefix in place forever. Rewrite legacy prompts to
  # `[fanout #N of #PARENT]` for any N in this run's *strong-ownership* set
  # (GitHub Sub-issues API links — explicit parent→child references). Weak
  # signals like body-task-list scans and --include must NOT trigger
  # migration: those numbers can be referenced from any parent's body, so
  # relabeling a legacy pane on that basis could silently transfer
  # ownership away from its original parent.
  #
  # $1 config_path  $2 parent (canonicalized)
  # $3 strong_children_csv (",N1,N2,N3,") — Sub-issues API set only
  # Honors $dry_run by logging the would-be count without writing.
  local config_path="$1" parent="$2" strong_children_csv="$3"
  local migrated_count
  migrated_count=$(jq -r --arg children "$strong_children_csv" '
    [(.panes // [])[]
     | select((.prompt // "") | test("^\\[fanout #[0-9]+\\]"))
     | ((.prompt // "") | capture("^\\[fanout #(?<n>[0-9]+)\\]")) as $m
     | select(",\($m.n)," | inside($children))
    ] | length
  ' "$config_path" 2>/dev/null) || migrated_count=0
  [[ "$migrated_count" =~ ^[0-9]+$ ]] || migrated_count=0
  (( migrated_count == 0 )) && return 0

  if (( dry_run )); then
    log_info "would migrate $migrated_count legacy [fanout #N] pane tag(s) to include parent #$parent"
    return 0
  fi

  local tmp="${config_path}.fanout-migrate.tmp"
  if jq --arg parent "$parent" --arg children "$strong_children_csv" '
    .panes = ((.panes // []) | map(
      if (.prompt // "") | test("^\\[fanout #[0-9]+\\]") then
        ((.prompt // "") | capture("^\\[fanout #(?<n>[0-9]+)\\](?<rest>.*)")) as $m
        | if ",\($m.n)," | inside($children)
          then .prompt = "[fanout #\($m.n) of #\($parent)]\($m.rest)"
          else .
          end
      else . end
    ))
  ' "$config_path" > "$tmp" 2>/dev/null && mv -f "$tmp" "$config_path"; then
    log_info "migrated $migrated_count legacy [fanout #N] pane tag(s) to include parent #$parent"
    return 0
  fi
  rm -f "$tmp"
  log_warn "could not migrate legacy pane tags in $config_path; falling back to strict idempotency so legacy panes don't mask new --status entries"
  return 1
}

enumerate_fanned_children() {
  # $1 dmux config_path.
  # $2 (optional) parent issue number — when given, restricts results to
  #    panes annotated for that parent. Numeric comparison via `10#` so a
  #    legacy pane tagged " of #0300" still matches `--status 300`.
  # $3 (optional) claim_csv (",N1,N2,") — when given, ALSO include legacy
  #    panes (no parent annotation) whose child number is in this set.
  #    The main flow passes the strong-ownership Sub-issues-API set here,
  #    which is exactly the set `migrate_legacy_pane_tags` would rewrite to
  #    `[fanout #N of #<parent>]`. Treating those legacy panes as
  #    already-fanned matches the post-migration state. Legacy panes whose
  #    numbers are only in weak signals (body-task-list / --include) are
  #    excluded so the main flow creates a fresh parent-tagged pane that
  #    `--status` (strict parent filter) can later see — instead of
  #    silently masking the child indefinitely.
  #    `--status` omits this arg, so every legacy pane is excluded for it.
  # With no $2, every fanned-out child is returned regardless of parent.
  #
  # Echoes a space-sentinel-wrapped set (e.g. " 42 43 ") so " 42 " membership
  # tests work without false positives on "142".
  #
  # Recognised prompt prefixes:
  #   [fanout #N]            — pre-#35 format, parent unknown
  #   [fanout #N of #P]      — current format, parent encoded
  local config_path="$1"
  local filter_parent="${2:-}"
  local claim_csv="${3:-}"
  local rows row n p set=' '
  # Parent annotation capture is `[^\]]+` rather than `[0-9]+` so it also
  # matches Projects v2 URLs that the main flow writes into the prompt for
  # `fanout <project-url>` (`[fanout #N of #https://github.com/...]`). The
  # legacy `[fanout #N]` form (no annotation) still matches via the
  # optional group.
  rows=$(jq -r '
    (.panes // [])
    | map(.prompt // "")
    | map(capture("^\\[fanout #(?<n>[0-9]+)( of #(?<p>[^\\]]+))?\\]") // null)
    | map(select(. != null))
    | map((.n // "") + "\t" + (.p // ""))
    | .[]
  ' "$config_path" 2>/dev/null || true)
  if [[ -n "$rows" ]]; then
    while IFS= read -r row; do
      [[ -z "$row" ]] && continue
      n="${row%%$'\t'*}"
      p="${row#*$'\t'}"
      [[ -z "$n" ]] && continue
      if [[ -n "$filter_parent" ]]; then
        if [[ -z "$p" ]]; then
          # Legacy pane (no parent annotation). Only count if the caller
          # has claimed this child number — i.e., it's known-owned (the
          # strong-signal set the main flow passes) so migration would
          # have rewritten the prompt. Otherwise the pane's true parent
          # is ambiguous and must not block fan-out under this one.
          [[ -n "$claim_csv" ]] || continue
          [[ "$claim_csv" == *",$n,"* ]] || continue
        elif [[ "$p" =~ ^[0-9]+$ ]] && [[ "$filter_parent" =~ ^[0-9]+$ ]]; then
          # Issue mode: numeric compare with `10#` to normalize leading
          # zeros so old `of #0300` panes match `--status 300`.
          (( 10#$p == 10#$filter_parent )) || continue
        else
          # Project mode (URL parent) or mismatched shapes: literal match.
          [[ "$p" == "$filter_parent" ]] || continue
        fi
      fi
      set+="$n "
    done <<<"$rows"
  fi
  printf '%s' "$set"
}

# --- arg parsing -------------------------------------------------------------

parent=''
agent=''
limit=''
only_arg=''
skip_arg=''
include_arg=''
session_arg=''
sleep_between=$default_sleep_between
popup_timeout=$default_popup_timeout
# Track whether the user actually passed --sleep / --popup-timeout (vs.
# the script's default). Value-comparison would silently accept
# `fanout --status N --sleep 4`, missing the documented exclusivity error.
sleep_explicit=0
popup_timeout_explicit=0
# Deferred --name parsing: collect raw values in the arg loop, parse them
# AFTER the --status exclusivity check so a malformed
# `--status 1 --name bad` reports the cannot-be-combined error (exit 2)
# instead of die'ing on the bad slug-hint (exit 1).
raw_name_args=()
dry_run=0
debug=0
unblocked_only=0
status_mode=0
status_filter='Todo'      # project mode only; 'all' disables the filter
parent_mode=''            # 'issue' | 'project' — set after positional validation
project_owner_type=''     # 'users' | 'orgs' (project mode)
project_owner=''
project_number=''
project_repo=''           # resolved lazily from gh_in_root in project mode

while (( $# > 0 )); do
  case "$1" in
    -h|--help)    usage; exit 0 ;;
    --agent)      agent="${2:-}";     shift 2 || die "--agent requires an argument" ;;
    --limit)      limit="${2:-}";     shift 2 || die "--limit requires an argument" ;;
    --only)       only_arg="${2:-}";  shift 2 || die "--only requires an argument" ;;
    --skip)       skip_arg="${2:-}";  shift 2 || die "--skip requires an argument" ;;
    --include)    include_arg="${2:-}"; shift 2 || die "--include requires an argument" ;;
    --name)       raw_name_args+=("${2:-}"); shift 2 || die "--name requires an argument" ;;
    --session)    session_arg="${2:-}"; shift 2 || die "--session requires an argument" ;;
    --project-status) status_filter="${2:-}"; shift 2 || die "--project-status requires an argument" ;;
    --sleep)      sleep_between="${2:-}"; sleep_explicit=1; shift 2 || die "--sleep requires an argument" ;;
    --popup-timeout) popup_timeout="${2:-}"; popup_timeout_explicit=1; shift 2 || die "--popup-timeout requires an argument" ;;
    --dry-run)    dry_run=1;          shift ;;
    --debug)      debug=1;            shift ;;
    --unblocked-only) unblocked_only=1; shift ;;
    --status)     status_mode=1;      shift ;;
    --)           shift; break ;;
    -*)
      log_err "unknown option: $1"
      usage >&2
      exit 2
      ;;
    *)
      if [[ -z "$parent" ]]; then
        parent="$1"
      else
        log_err "unexpected positional argument: $1"
        usage >&2
        exit 2
      fi
      shift
      ;;
  esac
done

if [[ -z "$parent" ]]; then
  usage >&2
  exit 2
fi
if [[ "$parent" =~ ^[0-9]+$ ]]; then
  parent_mode=issue
  # Canonicalize: "0300" → "300". Without this, the prompt prefix
  # `[fanout #N of #$parent]` and `--status` pane filtering both treat
  # numerically equivalent inputs as distinct parents and silently miss
  # their fanned children. Also defends any future `(( ))` site from
  # octal interpretation of leading-zero forms.
  parent="$((10#$parent))"
elif [[ "$parent" =~ ^https://github\.com/(users|orgs)/([^/]+)/projects/([0-9]+)([/?].*)?$ ]]; then
  parent_mode=project
  project_owner_type="${BASH_REMATCH[1]}"
  project_owner="${BASH_REMATCH[2]}"
  project_number="${BASH_REMATCH[3]}"
  # Canonicalize: drop any /views/<id> suffix and ?query=... so reruns of
  # semantically equivalent URLs ("/projects/3" vs "/projects/3/views/1"
  # vs "/projects/3?pane=issue") hit the same `[fanout #N of #<url>]`
  # idempotency tag. Project enumeration already keys off owner+number,
  # so the trailing context doesn't affect which items get fanned out.
  parent="https://github.com/$project_owner_type/$project_owner/projects/$project_number"
else
  if (( status_mode )); then
    log_err "--status: parent must be an integer issue number or Projects v2 URL, got: $parent"
    exit 2
  fi
  die "parent must be an integer issue number or Projects v2 URL, got: $parent"
fi
[[ -n "$status_filter" ]] || die "--project-status must not be empty"

# --status rejects every action-bearing flag (--debug is observability-only,
# allowed; -h exits 0 before this guard). Run BEFORE the numeric value
# validators below so `fanout --status N --sleep nope` reports the
# combination error (exit 2) instead of falling through to die'ing on the
# bad numeric (exit 1) — callers branch on the dedicated --status exit
# codes and shouldn't need to catch the main-flow ones.
status_conflict() {
  log_err "--status cannot be combined with $1"
  exit 2
}

if (( status_mode )); then
  # --status is the per-parent JSON reporter; the panes it reads carry
  # `[fanout #N of #<issue-number>]` prompts. Projects v2 parents are
  # not addressable through that prefix, so reject them up-front.
  [[ "$parent_mode" == "project" ]] && status_conflict "Projects v2 URLs as parent"
  [[ -n "$agent"          ]] && status_conflict "--agent"
  [[ -n "$limit"          ]] && status_conflict "--limit"
  [[ -n "$only_arg"       ]] && status_conflict "--only"
  [[ -n "$skip_arg"       ]] && status_conflict "--skip"
  [[ -n "$include_arg"    ]] && status_conflict "--include"
  (( ${#raw_name_args[@]} )) && status_conflict "--name"
  (( dry_run ))              && status_conflict "--dry-run"
  (( unblocked_only ))       && status_conflict "--unblocked-only"
  (( sleep_explicit ))         && status_conflict "--sleep"
  (( popup_timeout_explicit )) && status_conflict "--popup-timeout"
fi

# Safe to parse --name now: --status would have exited above on conflict.
# Malformed values still die (exit 1), which is the correct main-flow error.
if (( ${#raw_name_args[@]} > 0 )); then
  for _raw_name in "${raw_name_args[@]}"; do
    parse_name_arg "$_raw_name"
  done
fi

if [[ -n "$limit" ]] && ! [[ "$limit" =~ ^[1-9][0-9]*$ ]]; then
  die "--limit must be a positive integer, got: $limit"
fi
if ! [[ "$sleep_between" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
  die "--sleep must be a number, got: $sleep_between"
fi
if ! [[ "$popup_timeout" =~ ^[1-9][0-9]*$ ]]; then
  die "--popup-timeout must be a positive integer (seconds), got: $popup_timeout"
fi

if [[ -n "$only_arg" && -n "$skip_arg" ]]; then
  die "--only and --skip are mutually exclusive"
fi

only_set=' '
skip_set=' '
include_set=' '
[[ -n "$only_arg" ]] && only_set=$(parse_num_csv --only "$only_arg")
[[ -n "$skip_arg" ]] && skip_set=$(parse_num_csv --skip "$skip_arg")
[[ -n "$include_arg" ]] && include_set=$(parse_num_csv --include "$include_arg")

# --- dependency check --------------------------------------------------------

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || return 1
}

missing_deps=()
need_cmd gh    || missing_deps+=('gh (brew install gh)')
need_cmd jq    || missing_deps+=('jq (brew install jq)')

# tmux is needed for every code path that talks to a live dmux session, but
# `--status` with $DMUX_CONFIG_PATH reads the config file directly and never
# invokes tmux — let CI / offline runs report status without tmux installed.
if (( !status_mode )) || [[ -z "${DMUX_CONFIG_PATH:-}" ]]; then
  need_cmd tmux || missing_deps+=('tmux (brew install tmux)')
fi

# --status doesn't drive the popup intercept and doesn't fetch sub-issues, so
# pgrep + gh-sub-issue are not required for it. Project mode also goes
# through `gh api graphql` instead of the gh-sub-issue extension, so the
# extension is only required for the issue-mode main flow.
if (( !status_mode )); then
  need_cmd pgrep || missing_deps+=('pgrep (procps-ng on Linux; preinstalled on macOS)')

  if [[ "$parent_mode" == issue ]] \
    && ! gh extension list 2>/dev/null | cut -f1 | grep -qx 'gh sub-issue'; then
    missing_deps+=('gh-sub-issue extension (gh extension install yahsan2/gh-sub-issue)')
  fi
fi

if (( ${#missing_deps[@]} > 0 )); then
  log_err "missing dependencies:"
  for d in "${missing_deps[@]}"; do
    printf '  - %s\n' "$d" >&2
  done
  exit 1
fi

# --- dmux session discovery --------------------------------------------------

tmux_opt() {
  # $1 session, $2 option name. Returns empty string if unset.
  tmux show-options -v -t "$1" "$2" 2>/dev/null || true
}

gh_in_root() {
  (cd "$project_root" && gh "$@")
}

enumerate_project_items() {
  # Fetch all items from a Projects v2 board and emit children_json on stdout.
  #
  # Globals consumed (read-only): project_owner_type, project_owner,
  #   project_number, project_repo
  # Globals mutated: status_filter (only when the Project has no Status field
  #   AND the caller asked to filter; we warn once and fall back to 'all')
  #
  # Output shape (stdout): [{number, title, state, body, labels:[{name}]}, ...]
  # matching the contract the issue-mode path produces via gh-sub-issue +
  # gh issue view hydration.
  #
  # `gh project item-list --format json` doesn't return Status field values,
  # so we hit GraphQL directly with the right entry (`user` vs `organization`)
  # based on the URL form.
  local entry_field
  case "$project_owner_type" in
    users) entry_field='user' ;;
    orgs)  entry_field='organization' ;;
    *) die "internal: unknown project owner type: $project_owner_type" ;;
  esac

  # GraphQL variable refs use \$ so bash doesn't expand them.
  local gql
  read -r -d '' gql <<EOF || true
query(\$owner: String!, \$number: Int!, \$first: Int!, \$after: String) {
  ${entry_field}(login: \$owner) {
    projectV2(number: \$number) {
      title
      url
      field(name: "Status") { __typename }
      items(first: \$first, after: \$after) {
        nodes {
          content {
            __typename
            ... on Issue {
              number
              title
              state
              body
              repository { nameWithOwner }
              labels(first: 20) { nodes { name } }
            }
          }
          status: fieldValueByName(name: "Status") {
            ... on ProjectV2ItemFieldSingleSelectValue { name }
          }
        }
        pageInfo { hasNextPage endCursor }
      }
    }
  }
}
EOF

  # Accumulate raw page responses into an array; a single jq -s pass after
  # the loop flattens them. Reparsing $all_nodes on every page would be
  # O(n²) — this stays O(n) regardless of project size.
  local cursor='' page project_title='' pages=()
  while :; do
    local args=( api graphql
      -f "query=$gql"
      -F "owner=$project_owner"
      -F "number=$project_number"
      -F first=100 )
    [[ -n "$cursor" ]] && args+=( -F "after=$cursor" )

    if ! page=$(gh_in_root "${args[@]}" 2>&1); then
      die "gh api graphql (projectV2 items) failed: $page"
    fi

    # GraphQL returns projectV2: null for a syntactically valid URL when the
    # project number is wrong or the token can't see it. Catch it here so the
    # caller gets an actionable message instead of a jq null-arithmetic crash
    # in the final flatten pass.
    if [[ "$(jq -r ".data.${entry_field}.projectV2 // null | if . == null then 0 else 1 end" <<<"$page")" == "0" ]]; then
      die "Project not found or not accessible: $parent (check the URL, token scopes, and project visibility)"
    fi
    pages+=("$page")

    if [[ -z "$project_title" ]]; then
      project_title=$(jq -r ".data.${entry_field}.projectV2.title // \"\"" <<<"$page")
    fi

    # Status-field probe runs per page but only warns once: once status_filter
    # is set to 'all' (either by the user or by this fallback), the inner
    # condition stays false on subsequent pages.
    if [[ "$status_filter" != "all" ]]; then
      local has_status
      has_status=$(jq -r ".data.${entry_field}.projectV2.field // null | if . == null then 0 else 1 end" <<<"$page")
      if [[ "$has_status" == "0" ]]; then
        log_warn "Project '$project_title' has no Status field; ignoring --project-status $status_filter and falling back to all items"
        status_filter='all'
      fi
    fi

    local has_next end_cursor
    has_next=$(jq -r ".data.${entry_field}.projectV2.items.pageInfo.hasNextPage" <<<"$page")
    end_cursor=$(jq -r ".data.${entry_field}.projectV2.items.pageInfo.endCursor // empty" <<<"$page")
    [[ "$has_next" != "true" ]] && break
    cursor="$end_cursor"
  done

  local all_nodes
  all_nodes=$(printf '%s\n' "${pages[@]}" | jq -s --arg ef "$entry_field" \
    '[ .[] | .data[$ef].projectV2.items.nodes[] ]')

  # Cross-repo warn to stderr (children_json goes to stdout). Drafts and PR
  # items get silently dropped — only repo-matching Issues warrant a warn,
  # since cross-repo Issues are the user-surprise case.
  while IFS= read -r cross; do
    [[ -n "$cross" ]] && log_warn "skipping cross-repo project item: $cross (project root repo: $project_repo)"
  done < <(jq -r --arg repo "$project_repo" '
    .[] | select(.content.__typename == "Issue")
        | select(.content.repository.nameWithOwner != $repo)
        | "\(.content.repository.nameWithOwner)#\(.content.number)"
  ' <<<"$all_nodes")

  jq --arg repo "$project_repo" --arg status "$status_filter" '
    [ .[]
      | select(.content.__typename == "Issue")
      | select(.content.repository.nameWithOwner == $repo)
      | select($status == "all" or (.status.name // "") == $status)
      | {
          number: .content.number,
          title:  .content.title,
          state:  (.content.state | ascii_upcase),
          body:   (.content.body  // ""),
          labels: [ .content.labels.nodes[]? | {name} ]
        }
    ]
  ' <<<"$all_nodes"
}

pid_alive() {
  [[ -n "$1" ]] && [[ "$1" =~ ^[0-9]+$ ]] && kill -0 "$1" 2>/dev/null
}

session_is_dmux() {
  local s="$1"
  local pid
  pid=$(tmux_opt "$s" '@dmux_controller_pid')
  pid_alive "$pid"
}

validate_status_config() {
  # $1 path to a dmux config file. Exits 2 with a descriptive message if the
  # file isn't valid JSON or `.panes` exists with a non-array type. Combines
  # both checks into one jq invocation: a parse failure makes jq exit non-zero
  # before the filter runs, and a non-array `.panes` makes the filter return
  # false (jq -e exits 1). Either case maps to the documented `--status`
  # exit-code 2 ("cannot enumerate"), instead of leaking jq's raw codes or
  # silently misreporting `total: 0`.
  local config_path="$1"
  if ! jq -e '(.panes // []) | type == "array"' "$config_path" >/dev/null 2>&1; then
    log_err "--status: dmux config at $config_path is not valid JSON or .panes is not an array"
    exit 2
  fi
}

cmd_status() {
  # Read-only status reporter for already-fanned children. Writes one JSON
  # document to stdout. Exit codes documented in usage().

  # gh_in_root and enumerate_fanned_children read these from the script-global
  # namespace, matching how the main flow assigns them after session discovery.
  if [[ -n "${DMUX_CONFIG_PATH:-}" ]]; then
    # Escape hatch: read status from a checkpoint after the dmux session
    # has already exited. Key naming for project_root varies by dmux version;
    # fall back to two levels up, since dmux conventionally writes to
    # <repo>/.dmux/dmux.config.json.
    config_path="$DMUX_CONFIG_PATH"
    if [[ ! -f "$config_path" ]]; then
      log_err "--status: \$DMUX_CONFIG_PATH points to non-existent file: $config_path"
      exit 2
    fi
    validate_status_config "$config_path"
    project_root=$(jq -r '.projectRoot // .project_root // empty' "$config_path")
    [[ -n "$project_root" ]] || project_root=$(dirname "$(dirname "$config_path")")
  else
    if ! tmux list-sessions -F '#{session_name}' >/dev/null 2>&1; then
      log_err "--status: no tmux server is running (set DMUX_CONFIG_PATH to bypass live-session discovery)"
      exit 2
    fi
    local -a _ds=()
    local _s _pid
    while IFS= read -r _s; do
      _pid=$(tmux_opt "$_s" '@dmux_controller_pid')
      pid_alive "$_pid" && _ds+=("$_s")
    done < <(tmux list-sessions -F '#{session_name}')

    if (( ${#_ds[@]} == 0 )); then
      log_err "--status: no active dmux session found (set DMUX_CONFIG_PATH to bypass)"
      exit 2
    fi

    if [[ -n "$session_arg" ]]; then
      local _found=0
      for _s in "${_ds[@]}"; do
        if [[ "$_s" == "$session_arg" ]]; then
          _found=1
          session="$_s"
          break
        fi
      done
      if (( !_found )); then
        log_err "--status: tmux session '$session_arg' is not running dmux. Active dmux sessions: ${_ds[*]}"
        exit 2
      fi
    elif (( ${#_ds[@]} > 1 )); then
      log_err "--status: multiple dmux sessions active (${_ds[*]}); pass --session <name> to pick one"
      exit 2
    else
      session="${_ds[0]}"
    fi

    config_path=$(tmux_opt "$session" '@dmux_config_path')
    project_root=$(tmux_opt "$session" '@dmux_project_root')

    if [[ -z "$config_path" ]] || [[ ! -f "$config_path" ]]; then
      log_err "--status: dmux config not found at ${config_path:-<unset>}"
      exit 2
    fi
    validate_status_config "$config_path"
    if [[ -z "$project_root" ]]; then
      log_err "--status: session '$session' has no @dmux_project_root option"
      exit 2
    fi
  fi

  # gh_in_root will `cd "$project_root"` before each gh call; if the value
  # is missing on disk that `cd` fails and every child reports as a gh
  # failure (exit 3), masking the real "unusable config" problem behind
  # the documented enumeration-failure exit code (2).
  if [[ ! -d "$project_root" ]]; then
    log_err "--status: project_root is not a directory: ${project_root:-<empty>} (config=$config_path)"
    exit 2
  fi

  log_debug "--status: config=$config_path project_root=$project_root parent=$parent"

  # Filter by parent — sessions that have fanned multiple parents would
  # otherwise mix children, and `summary.all_merged` would lie.
  local fanned trimmed
  fanned=$(enumerate_fanned_children "$config_path" "$parent")
  trimmed="${fanned# }"
  trimmed="${trimmed% }"

  local -a nums_arr=()
  if [[ -n "$trimmed" ]]; then
    # shellcheck disable=SC2206
    nums_arr=($trimmed)
  fi

  # Deduplicate by child number: a child can legitimately have more than
  # one pane for the same parent (e.g. a stale pane from a manual cleanup
  # lag plus a fresh re-fan). The summary counters and `children[]` must
  # report one entry per issue, not one per pane.
  if (( ${#nums_arr[@]} > 1 )); then
    local -a unique_nums=()
    local _seen=' '
    for _n in "${nums_arr[@]}"; do
      [[ "$_seen" == *" $_n "* ]] && continue
      unique_nums+=("$_n")
      _seen+="$_n "
    done
    nums_arr=("${unique_nums[@]}")
  fi

  if (( ${#nums_arr[@]} == 0 )); then
    jq -n --argjson parent "$parent" '{
      parent: $parent,
      children: [],
      summary: { total: 0, merged: 0, pending: 0, all_merged: false }
    }'
    return 0
  fi

  local -a children_arr=()
  local n raw projected issue_state refs_json prs_json
  for n in "${nums_arr[@]}"; do
    raw=$(get_issue_with_prs "$n") || raw=''
    if [[ -z "$raw" ]]; then
      log_err "--status: gh issue view #$n failed (auth / network / not found)"
      exit 3
    fi
    issue_state=$(jq -r '.state // "UNKNOWN"' <<<"$raw") || {
      log_err "--status: failed to parse gh response for #$n"
      exit 3
    }
    refs_json=$(jq -c '
      (.closedByPullRequestsReferences // [])
      | if type == "array" then .
        elif type == "object" then (.nodes // [])
        else [] end
    ' <<<"$raw") || {
      log_err "--status: failed to parse gh response for #$n"
      exit 3
    }

    local -a prs_arr=()
    local ref selector pr_raw pr_projected
    while IFS= read -r ref; do
      [[ -z "$ref" ]] && continue
      if jq -e 'has("state") and (.state != null)' >/dev/null <<<"$ref"; then
        # Backward-compatible path for older fixtures / GraphQL-shaped refs
        # that already carry the hydrated PR state.
        pr_projected=$(jq -c '{ number, state, mergedAt: (.mergedAt // null) }' <<<"$ref") || {
          log_err "--status: failed to parse gh response for #$n"
          exit 3
        }
      else
        selector=$(jq -r '.url // .number // empty' <<<"$ref") || {
          log_err "--status: failed to parse gh response for #$n"
          exit 3
        }
        if [[ -z "$selector" ]]; then
          log_err "--status: gh response for #$n contains a PR ref without url or number"
          exit 3
        fi
        pr_raw=$(get_pr_with_status "$selector") || pr_raw=''
        if [[ -z "$pr_raw" ]]; then
          log_err "--status: gh pr view $selector failed for issue #$n"
          exit 3
        fi
        pr_projected=$(jq -c '{ number, state, mergedAt: (.mergedAt // null) }' <<<"$pr_raw") || {
          log_err "--status: failed to parse gh pr response for $selector"
          exit 3
        }
      fi
      prs_arr+=("$pr_projected")
    done < <(jq -c '.[]' <<<"$refs_json")

    if (( ${#prs_arr[@]} )); then
      prs_json=$(printf '%s\n' "${prs_arr[@]}" | jq -s '.')
    else
      prs_json='[]'
    fi

    projected=$(jq -n --argjson n "$n" --arg state "$issue_state" --argjson prs "$prs_json" '{
      num: $n,
      state: $state,
      prs: $prs,
      has_merged_pr: (any($prs[]; .state == "MERGED"))
    }') || {
      log_err "--status: failed to parse gh response for #$n"
      exit 3
    }
    children_arr+=("$projected")
  done

  local children_json
  children_json=$(printf '%s\n' "${children_arr[@]}" | jq -s '.')

  jq -n --argjson parent "$parent" --argjson children "$children_json" '{
    parent: $parent,
    children: $children,
    summary: {
      total:   ($children | length),
      merged:  ($children | map(select(.has_merged_pr)) | length),
      pending: ($children | map(select(.has_merged_pr | not)) | length),
      all_merged: (($children | length) > 0 and ($children | all(.has_merged_pr)))
    }
  }'
}

if (( status_mode )); then
  cmd_status
  exit 0
fi

if ! tmux list-sessions -F '#{session_name}' >/dev/null 2>&1; then
  die "no tmux server is running. Start dmux in your repo first: cd <repo> && dmux"
fi

all_sessions=()
while IFS= read -r _s; do
  all_sessions+=("$_s")
done < <(tmux list-sessions -F '#{session_name}')

dmux_sessions=()
for s in "${all_sessions[@]}"; do
  if session_is_dmux "$s"; then
    dmux_sessions+=("$s")
  fi
done

if (( ${#dmux_sessions[@]} == 0 )); then
  die "no active dmux session found. Start one with: cd <repo> && dmux"
fi

if [[ -n "$session_arg" ]]; then
  found=0
  for s in "${dmux_sessions[@]}"; do
    if [[ "$s" == "$session_arg" ]]; then
      found=1
      break
    fi
  done
  (( found )) || die "tmux session '$session_arg' is not running dmux. Active dmux sessions: ${dmux_sessions[*]}"
  session="$session_arg"
elif (( ${#dmux_sessions[@]} > 1 )); then
  die "multiple dmux sessions active (${dmux_sessions[*]}); pass --session <name> to pick one"
else
  session="${dmux_sessions[0]}"
fi

control_pane=$(tmux_opt "$session" '@dmux_control_pane')
config_path=$(tmux_opt  "$session" '@dmux_config_path')
project_root=$(tmux_opt "$session" '@dmux_project_root')

[[ -n "$control_pane" ]] || die "session '$session' has no @dmux_control_pane option; dmux may be in a broken state"
[[ -n "$config_path"  ]] || die "session '$session' has no @dmux_config_path option"
[[ -n "$project_root" ]] || die "session '$session' has no @dmux_project_root option"

if [[ ! -f "$config_path" ]]; then
  die "dmux config not found at $config_path (session reports it but file is missing)"
fi

log_info "dmux session: $session"
log_info "control pane: $control_pane"
log_info "project root: $project_root"
log_info "config:       $config_path"

# --- agent auto-detect -------------------------------------------------------
# If --agent was not explicit, look up the caller's tmux pane in
# dmux.config.json and inherit its .agent field. This makes the agent-picker
# popup navigation work out of the box when fanout is invoked from inside a
# dmux-managed agent session.
if [[ -z "$agent" ]] && [[ -n "${TMUX_PANE:-}" ]]; then
  detected_agent=$(jq -r --arg pid "$TMUX_PANE" '
    (.panes // [])
    | map(select(.paneId == $pid))
    | (.[0].agent // empty)
  ' "$config_path" 2>/dev/null || true)
  if [[ -n "$detected_agent" ]]; then
    agent="$detected_agent"
    log_info "auto-detected agent: $agent (from calling pane $TMUX_PANE)"
  fi
fi

# --- fetch children (sub-issues or project items) ---------------------------

# gh auto-detects the repo from cwd, so we'll chdir to project_root for any
# gh call. Sanity-check that cwd is actually a work tree.
if ! (cd "$project_root" 2>/dev/null && git rev-parse --is-inside-work-tree >/dev/null 2>&1); then
  die "project root $project_root is not a git work tree; cannot resolve GitHub repo"
fi

# parent_body is only populated in issue mode; in project mode it stays empty,
# and parse_blockers_from_parent_row's jq pipeline yields an empty result on
# empty input so --unblocked-only still works without code branches.
parent_body=''
body_nums=''

# Strong-ownership snapshot for the legacy-pane migration: only the child
# numbers GitHub explicitly links to this parent (Sub-issues API in issue
# mode, project items in project mode). body-task-list and --include
# numbers (added below) are weaker signals and must not be used to claim
# ownership of pre-existing legacy panes.
strong_children_csv=','

if [[ "$parent_mode" == project ]]; then
  # Cross-repo filter inside enumerate_project_items keys off project_repo.
  project_repo=$(gh_in_root repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) \
    || die "could not resolve repo via 'gh repo view' in $project_root (required for project mode cross-repo filter)"
  log_info "mode: project (status=$status_filter, repo=$project_repo)"
  log_info "fetching items from Project $parent"
  children_json=$(enumerate_project_items)
  strong_children_csv=",$(jq -r '[.[].number] | join(",")' <<<"$children_json"),"
else
  log_info "fetching sub-issues of #$parent"
  sub_issues_raw=$(gh_in_root sub-issue list "$parent" --json number,title,state 2>&1) \
    || die "gh sub-issue list failed: $sub_issues_raw"

  # gh-sub-issue v0.5.x wraps as {"subIssues":[...]} with lowercase state and
  # no body field; flatten + upcase to match downstream filters.
  children_json=$(jq '[.subIssues // [] | .[] | {number, title, state: (.state | ascii_upcase), body: "", labels: []}]' <<<"$sub_issues_raw")
  strong_children_csv=",$(jq -r '[.[].number] | join(",")' <<<"$children_json"),"

  # Also union children declared as task-list items in the parent body; some
  # parents list them there without using the Sub-issues API.
  parent_body=$(gh_in_root issue view "$parent" --json body -q .body 2>/dev/null) || {
    log_warn "could not read parent body (#$parent); skipping task-list scan"
    parent_body=''
  }

  # Only take the first `#N` immediately after the checkbox — ignore trailing
  # refs like "(blocked by #X, #Y)". Prose-only rows (no leading `#N`) skip
  # naturally because `capture` yields empty on non-match.
  body_nums=$(printf '%s' "$parent_body" | jq -Rrs '
    split("\n")
    | map(select(test("^[[:space:]]*-[[:space:]]+\\[[ xX]\\]")))
    | map([capture("^[[:space:]]*-[[:space:]]+\\[[ xX]\\][[:space:]]*#(?<n>[0-9]+)").n])
    | flatten | map(tonumber) | unique | .[]
  ')
fi

# --include numbers join the same hydrate path as body-scanned numbers in
# both modes (project mode contributes no body_nums of its own). parse_num_csv
# already validated each token is a positive integer, so we just splat
# include_set (space-sentinel-wrapped " 123 456 ") into a newline-separated
# list of extras.
extra_nums="$body_nums"
if [[ -n "$include_arg" ]]; then
  for _tok in $include_set; do
    extra_nums+=$'\n'"$_tok"
  done
fi

# Same sentinel-wrapped set idiom as fanned_set below so " 42 " membership
# doesn't false-match "142".
existing_set=' '
while IFS= read -r _n; do
  [[ -n "$_n" ]] && existing_set+="$_n "
done < <(jq -r '.[].number' <<<"$children_json")

body_details=()
for num in $extra_nums; do
  [[ -z "$num" ]] && continue
  [[ "$parent_mode" == issue && "$num" == "$parent" ]] && continue
  [[ "$existing_set" == *" $num "* ]] && continue
  detail=$(gh_in_root issue view "$num" --json number,title,state,body,labels 2>/dev/null) || {
    log_warn "parent body / --include references #$num but issue lookup failed; skipping"
    continue
  }
  body_details+=("$detail")
  existing_set+="$num "
done

if (( ${#body_details[@]} > 0 )); then
  extra_json=$(printf '%s\n' "${body_details[@]}" | jq -s '.')
  children_json=$(jq --argjson extra "$extra_json" '. + $extra' <<<"$children_json")
  if [[ "$parent_mode" == project ]]; then
    log_info "--include added ${#body_details[@]} extra child reference(s) not in project items"
  else
    log_info "parent body / --include added ${#body_details[@]} extra child reference(s) not in sub-issue API"
  fi
fi

# Count & filter.
total_children=$(jq 'length' <<<"$children_json")
if (( total_children == 0 )); then
  if [[ "$parent_mode" == project ]]; then
    log_info "no items in Project (after status/repo filter). nothing to do."
  else
    log_info "no sub-issues on #$parent. nothing to do."
  fi
  exit 0
fi

open_children_json=$(jq -c '[.[] | select(.state == "OPEN")]' <<<"$children_json")
open_count=$(jq 'length' <<<"$open_children_json")

if [[ "$parent_mode" == project ]]; then child_noun="project items"; else child_noun="sub-issues"; fi
log_info "$child_noun: $total_children total, $open_count OPEN"

if (( open_count == 0 )); then
  log_info "no OPEN $child_noun. nothing to do."
  exit 0
fi

# --- apply --only / --skip filter -------------------------------------------

filtered_only=()
filtered_skip=()
if [[ -n "$only_arg" || -n "$skip_arg" ]]; then
  # Snapshot the OPEN child numbers as a space-sentinel-wrapped set so we can
  # warn about `--only` entries that don't correspond to a child. Per issue
  # #11, fanout must refuse to silently `gh issue view` arbitrary numbers.
  open_set=' '
  while IFS= read -r _n; do
    [[ -n "$_n" ]] && open_set+="$_n "
  done < <(jq -r '.[].number' <<<"$open_children_json")

  if [[ -n "$only_arg" ]]; then
    for _n in $only_set; do
      [[ -n "$_n" ]] || continue
      [[ "$open_set" == *" $_n "* ]] || log_warn "--only: #$_n not in OPEN child set (ignored)"
    done
  fi

  filter_rows=()
  while IFS= read -r _row; do
    filter_rows+=("$_row")
  done < <(jq -c '.[]' <<<"$open_children_json")

  kept_rows=()
  for row in "${filter_rows[@]}"; do
    num=$(jq -r '.number' <<<"$row")
    if [[ -n "$only_arg" ]] && [[ "$only_set" != *" $num "* ]]; then
      filtered_only+=("$row")
    elif [[ -n "$skip_arg" ]] && [[ "$skip_set" == *" $num "* ]]; then
      filtered_skip+=("$row")
    else
      kept_rows+=("$row")
    fi
  done

  if (( ${#kept_rows[@]} == 0 )); then
    open_children_json='[]'
  else
    open_children_json=$(printf '%s\n' "${kept_rows[@]}" | jq -s -c '.')
  fi
  open_count=$(jq 'length' <<<"$open_children_json")

  if (( open_count == 0 )); then
    log_info "all OPEN sub-issues filtered out by --only/--skip. nothing to do."
    exit 0
  fi
fi

# --- eager hydrate body/labels for --unblocked-only --------------------------
# The Sub-issues API row has body="" and labels=[] placeholders; the main loop
# hydrates body lazily at use time. For --unblocked-only we need body+labels
# BEFORE the main loop so we can decide which children to defer. Skip any row
# whose body is already non-empty (came from parent-body scan hydration).
if (( unblocked_only )); then
  hydrated_rows=()
  while IFS= read -r _row; do
    # Rows from the parent-body scan already have body and labels populated
    # (they were fetched with `--json number,title,state,body,labels`).
    # Rows from the Sub-issues API path have body="" and labels=[] placeholders;
    # fetch body+labels for them now so blocker detection can run upfront.
    _body=$(jq -r '.body // ""' <<<"$_row")
    if [[ -z "$_body" ]]; then
      _num=$(jq -r '.number' <<<"$_row")
      _detail=$(gh_in_root issue view "$_num" --json body,labels 2>/dev/null) \
        || { log_warn "#$_num: could not fetch body/labels for blocker check; treating as unblocked"; _detail='{"body":"","labels":[]}'; }
      _row=$(jq --argjson d "$_detail" '. + $d' <<<"$_row")
    fi
    hydrated_rows+=("$_row")
  done < <(jq -c '.[]' <<<"$open_children_json")
  if (( ${#hydrated_rows[@]} > 0 )); then
    open_children_json=$(printf '%s\n' "${hydrated_rows[@]}" | jq -s -c '.')
  fi
fi

# --- migrate legacy pane tags ------------------------------------------------
# Pre-#35 panes carry `[fanout #N]` (no parent annotation). Rewrite any whose
# child number is in this parent's *Sub-issues API* set so a subsequent
# `fanout --status <parent>` picks them up. Restricted to the strong-ownership
# signal: legacy panes whose number is referenced only via task-list / --include
# (signals that any parent body can carry) are left alone — relabeling them
# could silently transfer ownership from another parent.
idempotency_claim="$strong_children_csv"
if ! migrate_legacy_pane_tags "$config_path" "$parent" "$strong_children_csv"; then
  # Write failed (jq error / read-only config). The legacy panes the run
  # would have migrated stayed legacy on disk, so the strong-signal claim
  # is no longer accurate. Drop the claim entirely — the main flow then
  # creates fresh parent-annotated panes for those numbers (resulting in
  # duplicate panes that the user resolves in the dmux TUI), which is
  # preferable to `--status <parent>` polling an entry that never reflects
  # reality.
  idempotency_claim=""
fi

# --- idempotency: find existing fanout-tagged panes --------------------------

# Scope idempotency to THIS parent's children: panes annotated for a
# different parent should not block fan-out under the current one (parents
# can share child refs via task-list scan or --include). The optional
# claim CSV ALSO admits legacy `[fanout #N]` panes whose number is in the
# Sub-issues API set — those are exactly the panes `migrate_legacy_pane_tags`
# would rewrite, so treating them as already-fanned matches the post-
# migration state. Legacy panes whose ownership can't be proven (weak
# signals only) are excluded here on purpose so a fresh parent-annotated
# pane is created, surfacing them in `--status`.
# Space-delimited and sentinel-wrapped so " 42 " membership tests work
# without false positives on "142".
fanned_set=$(enumerate_fanned_children "$config_path" "$parent" "$idempotency_claim")

# --- split into targets / skipped -------------------------------------------

all_rows=()
while IFS= read -r _row; do
  all_rows+=("$_row")
done < <(jq -c '.[]' <<<"$open_children_json")

targets=()
skipped=()
for row in "${all_rows[@]}"; do
  num=$(jq -r '.number' <<<"$row")
  if [[ "$fanned_set" == *" $num "* ]]; then
    skipped+=("$num")
  else
    targets+=("$row")
  fi
done

if (( ${#targets[@]} == 0 )); then
  log_ok "all ${#skipped[@]} OPEN sub-issue(s) already have a fanout pane. nothing to do."
  exit 0
fi

# --- apply --unblocked-only filter ------------------------------------------

blocked_rows=()
blocked_refs=()
if (( unblocked_only )); then
  still_targets=()
  for row in "${targets[@]}"; do
    num=$(jq -r '.number' <<<"$row")
    child_body=$(jq -r '.body // ""' <<<"$row")
    child_labels=$(jq -r '(.labels // []) | map(.name) | join(",")' <<<"$row")

    b1=$(parse_blockers_from_child_body "$child_body")
    b2=$(parse_blockers_from_parent_row "$parent_body" "$num")
    # Dedupe into a space-separated list of unique blocker numbers.
    blockers=$(printf '%s %s\n' "$b1" "$b2" | tr ' ' '\n' | awk 'NF' | sort -u | tr '\n' ' ')
    blockers="${blockers% }"

    open_blockers=()
    for b in $blockers; do
      get_issue_state "$b"
      [[ "$GET_ISSUE_STATE_RESULT" == "OPEN" ]] && open_blockers+=("$b")
    done

    if [[ ",$child_labels," == *",blocked,"* ]] && [[ -z "$blockers" ]]; then
      log_warn "#$num: has 'blocked' label but no parseable blocker numbers — treating as unblocked"
    fi

    if (( ${#open_blockers[@]} > 0 )); then
      open_refs=''
      for b in "${open_blockers[@]}"; do
        open_refs+="OPEN #$b, "
      done
      open_refs="${open_refs%, }"
      log_info "deferred: #$num (blocked by $open_refs)"
      blocked_rows+=("$row")
      blocked_refs+=("$open_refs")
    else
      still_targets+=("$row")
    fi
  done
  targets=("${still_targets[@]}")
fi

# --- apply limit -------------------------------------------------------------

limit_deferred=()
if [[ -n "$limit" ]] && (( ${#targets[@]} > limit )); then
  limit_deferred=("${targets[@]:limit}")
  targets=("${targets[@]:0:limit}")
fi

if (( ${#skipped[@]} > 0 )); then
  log_info "already fanned-out (skipping): #${skipped[*]}"
fi
log_info "will create ${#targets[@]} pane(s); deferred (blocked): ${#blocked_rows[@]}; deferred (--limit): ${#limit_deferred[@]}"

if (( dry_run )) && (( ${#filtered_only[@]} + ${#filtered_skip[@]} > 0 )); then
  printf '\n%sfiltered out:%s\n' "$C_INFO" "$C_RESET"
  if (( ${#filtered_only[@]} > 0 )); then
    for row in "${filtered_only[@]}"; do
      printf '  #%s %s — not in --only\n' \
        "$(jq -r '.number' <<<"$row")" "$(jq -r '.title' <<<"$row")"
    done
  fi
  if (( ${#filtered_skip[@]} > 0 )); then
    for row in "${filtered_skip[@]}"; do
      printf '  #%s %s — in --skip\n' \
        "$(jq -r '.number' <<<"$row")" "$(jq -r '.title' <<<"$row")"
    done
  fi
  printf '\n'
fi

if (( dry_run )) && (( ${#blocked_rows[@]} > 0 )); then
  printf '\n%sdeferred (blocked):%s\n' "$C_INFO" "$C_RESET"
  for i in "${!blocked_rows[@]}"; do
    row="${blocked_rows[$i]}"
    refs="${blocked_refs[$i]}"
    printf '  #%s %s — blocked by %s\n' \
      "$(jq -r '.number' <<<"$row")" "$(jq -r '.title' <<<"$row")" "$refs"
  done
  printf '\n'
fi

# --- briefing file builder ---------------------------------------------------

repo_slug=$(basename "$project_root")

briefing_path() {
  printf '/tmp/fanout-%s-%s.md' "$repo_slug" "$1"
}

write_briefing() {
  local num="$1" title="$2" body="$3"
  local path
  path=$(briefing_path "$num")
  cat >"$path" <<EOF
You are assigned GitHub issue #$num in this repository.

Title: $title

Body:
$body

Requirements:
- You are working inside a git worktree that was prepared for this task. Do not create additional worktrees.
- Make focused, minimal changes scoped to this single issue.
- Run the project's lint/test commands if they exist (inspect package.json / Makefile / pyproject.toml first).
- When implementation passes tests, commit and push the branch.
- Open a pull request with "Closes #$num" in the body.
- If the scope is ambiguous, stop and leave a comment on the issue instead of guessing.
EOF
  if [[ "${agent:-}" == "claude" ]]; then
    cat >>"$path" <<'EOF'

Optional: Agent Teams (Claude Code v2.1.32+, requires CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1)

Before starting, decide whether this issue benefits from spawning an Agent Team.
This is a hint, not a rule — if Agent Teams aren't enabled in your environment,
or the issue doesn't fit the criteria below, just proceed as a single session.

Consider Agent Teams when the issue involves:
- Open-ended research or investigation that benefits from multiple angles
  (RFC drafting, library evaluation, root-cause hunts with competing hypotheses).
- New feature work that splits cleanly across independent layers
  (e.g. backend handler + frontend integration + tests, each ownable separately).
- Refactors where files partition naturally so teammates won't collide.
- Reviewing a large diff where security / performance / coverage are distinct lenses.

Skip Agent Teams (single session is better) when:
- The change is sequential or mostly in one file.
- Subtasks share state and would race on the same files.
- The fix is small and focused (typo, single bug, config bump).

If you decide to use Agent Teams:
1. Sketch 3-5 self-contained subtasks with clear deliverables before spawning.
2. Spawn teammates with task-specific prompts that include the issue scope they own.
3. Coordinate via the shared task list; let teammates self-claim where possible.
4. Synthesize findings yourself before opening the PR.
5. Ask the lead to "Clean up the team" before closing the issue.
   Token cost scales linearly with teammate count — favor 3 focused teammates over 5 scattered ones.
EOF
  fi
  printf '%s' "$path"
}

# --- tmux driving ------------------------------------------------------------

tmux_send_keys() {
  # Fire named keys at the dmux control pane. Only used to trigger the
  # new-pane popup (Escape + n) — the actual prompt delivery happens via
  # popup result-file injection, not send-keys, because dmux v5.6.3 renders
  # its new-pane prompt inside `tmux display-popup` which is a separate
  # tmux client that send-keys cannot address.
  if (( dry_run )); then
    printf '    %s$ tmux send-keys -t %s %s%s\n' "$C_DIM" "$control_pane" "$*" "$C_RESET"
    return 0
  fi
  tmux send-keys -t "$control_pane" "$@"
}

panes_len() {
  jq '(.panes // []) | length' "$config_path" 2>/dev/null || printf '0'
}

wait_for_new_pane() {
  local baseline="$1" deadline
  deadline=$(( $(date +%s) + default_wait_timeout ))
  while (( $(date +%s) < deadline )); do
    local cur
    cur=$(panes_len)
    if (( cur > baseline )); then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

# --- dmux popup intercept ----------------------------------------------------
# dmux v5.6.3 drives input via `tmux display-popup -E 'node <popup>.js
# <resultFile> [args]'`. The popup writes its user-entered answer to
# <resultFile> as JSON; the dmux parent reads that file when the popup child
# exits. We piggyback on that contract: trigger the popup, find its PID and
# its resultFile from ps argv, atomically write our own JSON to the file,
# and kill the popup process. dmux sees a "successful submission" and
# proceeds as if a human had typed the answer.
#
# newPanePopup payload:     {"success":true,"data":"<prompt>"}
# agentChoicePopup payload: {"success":true,"data":["<agent>"]}
#
# dmux always launches agentChoicePopup after newPanePopup closes with a
# non-empty prompt (see selectAgentsForPaneCreation in DmuxApp.js), even
# when only one agent is enabled — so both must be intercepted per issue.

popup_pid_baseline() {
  # Space-sentinel-wrapped set of PIDs matching any dmux popup script, so
  # find_new_popup can tell "already running before we started" from "just
  # spawned by our `n` keystroke".
  local pids=' ' pid
  while IFS= read -r pid; do
    [[ -n "$pid" ]] && pids+="$pid "
  done < <(pgrep -f '/popups/.*Popup\.js' 2>/dev/null || true)
  printf '%s' "$pids"
}

find_new_popup() {
  # $1 script-name fragment (e.g. 'newPanePopup\.js')
  # $2 baseline PID set
  # $3 timeout tenths of a second (default 50 = 5s)
  # Prints "<pid>\t<resultFile>" on success, returns 1 on timeout.
  #
  # `pgrep -f` matches the full argv, so for a single popup dmux spawns it
  # typically hits FOUR processes that all carry the script path: the outer
  # `sh -c` dmux spawns, the `tmux display-popup` it runs, the inner shell
  # tmux creates, and finally the Node.js popup. Killing anything but the
  # Node process leaves the real popup orphaned on the tmux client, which
  # lets dmux advance (it sees its spawned child exit and reads the result
  # file we wrote) while blocking the next `display-popup` from opening —
  # exactly the "popup 1 succeeds, popup 2 never appears" failure mode we
  # kept hitting. Filter on COMM so only the Node popup is returned.
  local pattern="$1" baseline="$2" max_iters="${3:-50}"
  local i=0 pid args rf comm
  while (( i < max_iters )); do
    while IFS= read -r pid; do
      [[ -z "$pid" ]] && continue
      [[ "$baseline" == *" $pid "* ]] && continue
      comm=$(ps -o comm= -p "$pid" 2>/dev/null) || continue
      # macOS BSD ps returns the full path; procps-ng returns the basename.
      # Normalize so `/usr/local/bin/node`, `node`, `node24` all match.
      [[ "$(basename "$comm")" == node* ]] || continue
      args=$(ps -o args= -p "$pid" 2>/dev/null) || continue
      rf=$(grep -oE '[[:alnum:]/_.-]+/dmux-popup-[0-9]+\.json' <<<"$args" | head -1)
      if [[ -n "$rf" ]]; then
        printf '%s\t%s\n' "$pid" "$rf"
        return 0
      fi
    done < <(pgrep -f "$pattern" 2>/dev/null)
    sleep 0.1
    i=$(( i + 1 ))
  done
  return 1
}

write_popup_result() {
  # Atomic write: tmp-in-same-dir then rename. dmux only reads the file
  # after the popup child exits, so as long as we rename before killing
  # the child, the read sees a complete payload.
  local path="$1" payload="$2"
  local tmp="${path}.fanout.tmp"
  printf '%s' "$payload" >"$tmp"
  mv -f "$tmp" "$path"
}

make_newpane_result() {
  jq -cn --arg p "$1" '{success:true, data:$p}'
}

make_agent_result() {
  jq -cn --arg a "$1" '{success:true, data:[$a]}'
}

intercept_popup() {
  # $1 pattern, $2 baseline, $3 payload, $4 human label, $5 timeout (tenths)
  # Returns 0 if the popup was found + payload written + process killed.
  local pattern="$1" baseline="$2" payload="$3" label="$4" timeout="${5:-50}"
  local line pid rf
  if ! line=$(find_new_popup "$pattern" "$baseline" "$timeout"); then
    log_err "  $label popup did not appear within $(( timeout / 10 ))s"
    return 1
  fi
  pid="${line%%$'\t'*}"
  rf="${line#*$'\t'}"
  log_debug "$label popup pid=$pid resultFile=$rf"
  # Give dmux's PopupWrapper time to mount and write its readyFile so the
  # parent's readyPromise (utils/popup.js::waitForPopupReady) resolves via
  # the ready-file path rather than via child.close after we kill. 150ms
  # comfortably covers the React Ink useEffect tick; it is negligible next
  # to --sleep's rate-limit gap.
  sleep 0.15
  write_popup_result "$rf" "$payload"
  log_debug "$label wrote: $payload"
  kill "$pid" 2>/dev/null || true
  log_debug "$label killed pid=$pid"
}

create_pane_for_issue() {
  local num="$1" title="$2" body="$3"
  local briefing
  briefing=$(write_briefing "$num" "$title" "$body")

  local short_title="${title:0:60}"
  local slug_hint display_name
  slug_hint=$(name_get_slug_hint "$num")
  display_name=$(name_get_display_name "$num")
  local one_line_prompt
  # When a slug-hint is supplied, front-load it into the one-line prompt so
  # dmux's generateSlug() (which asks the LLM for "1-2 word kebab-case slug
  # for this prompt") echoes our kebab-case hint back as the actual slug.
  # The "[fanout #N of #PARENT]" idempotency prefix stays at the very front
  # — the parent annotation is what lets `--status` filter to one parent in
  # sessions where multiple parents have been fanned.
  if [[ -n "$slug_hint" ]]; then
    printf -v one_line_prompt '%s%s of #%s] %s: %s. read %s and begin.' \
      "$FANOUT_TAG_PREFIX" "$num" "$parent" "$slug_hint" "$short_title" "$briefing"
  else
    printf -v one_line_prompt '%s%s of #%s] %s: read %s and begin.' \
      "$FANOUT_TAG_PREFIX" "$num" "$parent" "$short_title" "$briefing"
  fi

  log_info "#$num: $short_title"
  log_dim "  briefing -> $briefing"
  [[ -n "$slug_hint" ]] && log_dim "  slug-hint -> $slug_hint"
  [[ -n "$display_name" ]] && log_dim "  display-name -> $display_name"

  local baseline
  baseline=$(panes_len)

  local newpane_payload agent_payload
  newpane_payload=$(make_newpane_result "$one_line_prompt")
  agent_payload=''
  [[ -n "$agent" ]] && agent_payload=$(make_agent_result "$agent")

  if (( dry_run )); then
    printf '  %sbriefing size%s: %d bytes\n' "$C_DIM" "$C_RESET" "$(wc -c <"$briefing")"
    printf '  %scurrent panes[] length%s: %s\n' "$C_DIM" "$C_RESET" "$baseline"
    tmux_send_keys Escape
    tmux_send_keys n
    printf '    %s# would intercept newPanePopup and write: %s%s\n' "$C_DIM" "$newpane_payload" "$C_RESET"
    if [[ -n "$agent_payload" ]]; then
      printf '    %s# would intercept agentChoicePopup and write: %s%s\n' "$C_DIM" "$agent_payload" "$C_RESET"
    else
      printf '    %s# WOULD FAIL: agent is empty (pass --agent or run from a dmux pane)%s\n' "$C_WARN" "$C_RESET"
    fi
    log_ok "#$num: dry-run complete"
    return 0
  fi

  if [[ -z "$agent_payload" ]]; then
    log_err "#$num: no agent resolved. dmux v5.6.3 always shows the agent-choice popup after the prompt popup, so fanout needs an agent name. Pass --agent <name> or invoke fanout from a dmux-managed pane."
    return 1
  fi

  local pid_baseline
  pid_baseline=$(popup_pid_baseline)

  tmux_send_keys Escape
  sleep 0.2
  tmux_send_keys n

  intercept_popup 'newPanePopup\.js' "$pid_baseline" "$newpane_payload" '  newPanePopup' "$(( popup_timeout * 10 ))" \
    || return 1

  # The agent-choice popup is spawned after dmux reads the first resultFile.
  # Refresh baseline to exclude the just-killed PID and anything unrelated.
  pid_baseline=$(popup_pid_baseline)

  intercept_popup 'agentChoicePopup\.js' "$pid_baseline" "$agent_payload" '  agentChoicePopup' "$(( popup_timeout * 10 ))" \
    || return 1

  if wait_for_new_pane "$baseline"; then
    log_ok "#$num: pane created (panes[] now $(panes_len))"
    return 0
  else
    log_err "#$num: timed out after ${default_wait_timeout}s waiting for config.json to grow"
    return 1
  fi
}

# --- displayName application -------------------------------------------------
# Runs once at the very end of the main loop (not per-iteration) so it can't
# race against dmux's in-memory state overwriting dmux.config.json on the next
# pane creation. dmux's usePanes.loadPanes (5-30s poll) rereads the file and
# enforcePaneTitles pushes displayName into tmux pane borders; the separate
# worktree-metadata.json write is what survives dmux restarts (reopenWorktree
# reads it). See plan file / CLAUDE.md for why a two-file write is needed.

apply_display_names() {
  local num disp pane_slug worktree_path lookup meta_path tmp
  local applied=0

  for num in "${created_nums[@]}"; do
    disp=$(name_get_display_name "$num")
    [[ -z "$disp" ]] && continue

    if (( dry_run )); then
      printf '    %s# would set panes[].displayName for #%s = %q%s\n' \
        "$C_DIM" "$num" "$disp" "$C_RESET"
      printf '    %s# would merge displayName into <worktree>/.dmux/worktree-metadata.json%s\n' \
        "$C_DIM" "$C_RESET"
      applied=$(( applied + 1 ))
      continue
    fi

    # Locate the pane by `[fanout #NUM of #PARENT]` prompt prefix so matching
    # survives even if dmux tweaked slug post-generation. Parent-scoped
    # idempotency lets the same child number live in multiple panes (one
    # per parent), so matching on the child number alone could write the
    # displayName into a sibling parent's pane / worktree.
    #
    # Use startswith (literal) instead of test() because in project mode
    # `$parent` is a full Projects v2 URL containing regex metacharacters
    # (`:`, `/`, `.`, and possibly `?` from query strings); a test()-based
    # regex match would misinterpret those. The pane was created earlier
    # in this same run with `$parent` already in its canonical form, so an
    # exact-prefix match is sufficient — no normalization needed.
    lookup=$(jq -r --arg num "$num" --arg parent "$parent" '
      (.panes // [])
      | map(select((.prompt // "")
                   | startswith("[fanout #" + $num + " of #" + $parent + "]")))
      | (.[0] // {} | "\(.slug // "")\t\(.worktreePath // "")")
    ' "$config_path" 2>/dev/null || printf '\t')

    pane_slug="${lookup%%$'\t'*}"
    worktree_path="${lookup#*$'\t'}"

    if [[ -z "$pane_slug" ]]; then
      log_warn "#$num: could not locate pane in dmux.config.json by [fanout #$num of #$parent] prefix; displayName skipped"
      continue
    fi

    # 1) dmux.config.json — atomic update. Matching by slug (not by .prompt)
    # so we don't mis-target if the prompt string gets edited later.
    tmp="${config_path}.fanout.tmp"
    if jq --arg slug "$pane_slug" --arg disp "$disp" '
      .panes = ((.panes // []) | map(
        if .slug == $slug then .displayName = $disp else . end
      ))
    ' "$config_path" >"$tmp" 2>/dev/null; then
      mv -f "$tmp" "$config_path"
    else
      rm -f "$tmp"
      log_warn "#$num: jq failed to update dmux.config.json; displayName partially applied"
      continue
    fi

    # 2) worktree-metadata.json — merge preserving existing agent /
    # permissionMode / branchName / mergeTargetChain fields. This is the
    # durable store: reopenWorktree.js (22, 132) and paneCreation.js (341,
    # 437) restore displayName from here across dmux restarts.
    if [[ -n "$worktree_path" && -d "$worktree_path" ]]; then
      meta_path="$worktree_path/.dmux/worktree-metadata.json"
      mkdir -p "$(dirname "$meta_path")"
      tmp="${meta_path}.fanout.tmp"
      local meta_ok=0
      if [[ -f "$meta_path" ]]; then
        if jq --arg disp "$disp" '. + {displayName: $disp}' "$meta_path" >"$tmp" 2>/dev/null; then
          meta_ok=1
        fi
      else
        if jq -n --arg disp "$disp" '{displayName: $disp}' >"$tmp" 2>/dev/null; then
          meta_ok=1
        fi
      fi
      if (( meta_ok )); then
        mv -f "$tmp" "$meta_path"
      else
        rm -f "$tmp"
        log_warn "#$num: jq failed to produce worktree-metadata.json; displayName will not survive dmux restart"
      fi
    else
      log_warn "#$num: worktreePath not found ($worktree_path); displayName will not survive dmux restart"
    fi

    log_ok "#$num: displayName -> \"$disp\" (slug=$pane_slug)"
    applied=$(( applied + 1 ))
  done

  if (( applied > 0 )) && ! (( dry_run )); then
    log_info "displayName applied to $applied pane(s); dmux's enforcePaneTitles poll (5-30s) will push them to tmux pane borders"
  fi
}

# --- main loop ---------------------------------------------------------------

created=0
failed=0
created_nums=()
for row in "${targets[@]}"; do
  num=$(jq -r '.number' <<<"$row")
  title=$(jq -r '.title' <<<"$row")
  body=$(jq -r '.body // ""' <<<"$row")
  if [[ -z "$body" ]]; then
    body=$(gh_in_root issue view "$num" --json body -q .body 2>/dev/null || printf '')
  fi

  if create_pane_for_issue "$num" "$title" "$body"; then
    created=$(( created + 1 ))
    created_nums+=("$num")
  else
    failed=$(( failed + 1 ))
    log_warn "stopping early — manual inspection needed"
    break
  fi

  # don't sleep after the last one
  if (( created + failed < ${#targets[@]} )); then
    sleep "$sleep_between"
  fi
done

# Apply displayNames once everything is created (or in dry-run, just print
# the plan). Keyed on created_nums so a failed / skipped issue is not
# targeted, and gated on name_has_any_display_name so a bare --name
# (slug-hint only) short-circuits cleanly.
if (( ${#created_nums[@]} > 0 )) && name_has_any_display_name; then
  apply_display_names
fi

# --- summary -----------------------------------------------------------------

printf '\n'
if (( created > 0 )); then log_ok   "created: $created"; fi
if (( failed > 0 )); then log_err  "failed:  $failed"; fi
if (( ${#skipped[@]} > 0 )); then log_info "skipped (already fanned-out): ${#skipped[@]}"; fi
if (( ${#filtered_only[@]} + ${#filtered_skip[@]} > 0 )); then
  log_info "skipped (filtered): $(( ${#filtered_only[@]} + ${#filtered_skip[@]} ))"
fi
if (( ${#blocked_rows[@]} > 0 )); then
  log_info "deferred (blocked): ${#blocked_rows[@]}"
fi

if (( ${#limit_deferred[@]} > 0 )); then
  printf '\n%sDeferred %d issue(s) due to --limit. Rerun with:%s\n' "$C_INFO" "${#limit_deferred[@]}" "$C_RESET"
  limit_deferred_nums=()
  for row in "${limit_deferred[@]}"; do
    limit_deferred_nums+=("#$(jq -r '.number' <<<"$row")")
  done
  printf '  %s\n' "${limit_deferred_nums[*]}"
  # Every substituted value is run through `printf %q` so the printed
  # command is safe to copy-paste: Project URLs can contain `&` query
  # parameters, Status / session / agent names can contain spaces.
  agent_flag=''
  [[ -n "$agent" ]] && agent_flag=" --agent $(printf '%q' "$agent")"
  session_flag=''
  [[ -n "$session_arg" ]] && session_flag=" --session $(printf '%q' "$session_arg")"
  filter_flag=''
  [[ -n "$only_arg" ]] && filter_flag=" --only $(printf '%q' "$only_arg")"
  [[ -n "$skip_arg" ]] && filter_flag=" --skip $(printf '%q' "$skip_arg")"
  unblocked_flag=''
  (( unblocked_only )) && unblocked_flag=' --unblocked-only'
  # --project-status defaults to "Todo" when omitted, so only re-emit it
  # when the user passed something non-default (otherwise we'd silently
  # narrow the rerun).
  status_flag=''
  if [[ "$parent_mode" == project && "$status_filter" != "Todo" ]]; then
    status_flag=" --project-status $(printf '%q' "$status_filter")"
  fi
  printf '  fanout %q --limit %d%s%s%s%s%s\n' "$parent" "${#limit_deferred[@]}" "$status_flag" "$filter_flag" "$unblocked_flag" "$agent_flag" "$session_flag"
fi

(( failed > 0 )) && exit 1
exit 0
